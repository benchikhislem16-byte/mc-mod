  "authors": [
    "WildernessCull Team"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/example/wilderness-cull"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.wildernesscull.WildernessCullClient"
    ]
  },
  "mixins": [
    "wildernesscull.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "conflicts": {
    "entityculling": "*"
  }
}
